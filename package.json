{
  "name": "nhia-backend",
  "version": "1.0.0",
  "description": "NHIA Annual Report Backend API",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:setup": "node src/scripts/dbSetup.js",
    "db:sync": "node src/scripts/syncDb.js",
    "db:sync:active": "node src/scripts/redesign/syncActiveSchema.js",
    "db:purge:legacy": "node src/scripts/redesign/purgeNonCoreTables.js",
    "db:purge:legacy:confirm": "node src/scripts/redesign/purgeNonCoreTables.js --confirm",
    "db:migrate:department-code-pk": "node src/scripts/redesign/migrateDepartmentCodePk.js",
    "db:update-store": "node src/scripts/updateStoreDb.js",
    "db:update-admin-hr": "node src/scripts/updateAdminHrDb.js",
    "db:seed-admin-hr": "node src/scripts/seedAdminHr.js",
    "db:seed-store": "node src/scripts/seedStoreManagement.js",
    "db:seed-all": "node src/scripts/seedAll.js",
    "db:seed-state-office": "node src/scripts/seedStateOfficeData.js",
    "db:seed-enrolment": "node src/scripts/seedEnrolmentActivity.js",
    "db:sync-stakeholder-fields": "node src/scripts/addStakeholderEngagementFields.js",
    "db:seed-dashboard-demo": "node src/scripts/seedRoleDashboardDemo.js",
    "db:reset-org": "node src/scripts/resetOrgKeepAdminSdo.js",
    "db:seed-complaint-sla": "node src/scripts/seedComplaintSla.js",
    "db:seed-linking-dept": "node src/scripts/seedLinkingDepartmentsHeadOfUnit.js",
    "db:seed-servicom-batch": "node src/scripts/runServicomSurveyComplaintCharterSeed.js",
    "db:fix-servicom-fks": "node src/scripts/fixServicomForeignKeys.js",
    "db:sync-servicom-complaints": "node src/scripts/syncServicomComplaintsSchema.js",
    "db:sync-accredited-providers": "node src/scripts/syncAccreditedProviders.js",
    "db:seed-hcf": "node src/scripts/seedHcfMasterFacilities.js",
    "db:seed-hmo": "node src/scripts/seedHmoProviders.js",
    "db:seed-enforcement-dashboard": "node src/scripts/seedEnforcementDashboardDemo.js",
    "db:seed-servicom-dashboard": "node src/scripts/seedServicomDashboardDemo.js",
    "db:seed-store-pack": "node src/scripts/seedStorePackDemo.js",
    "db:seed-enrolment-pack": "node src/scripts/seedEnrolmentDemo.js",
    "db:seed-enrolment-drive-pack": "node src/scripts/seedEnrolmentDriveDemo.js",
    "db:seed-beneficiary-pack": "node src/scripts/seedBeneficiaryDemo.js",
    "db:seed-stakeholder-pack": "node src/scripts/seedStakeholderDemo.js",
    "db:seed-provider-pack": "node src/scripts/seedProviderManagementDemo.js",
    "db:seed-hmo-indebtedness-pack": "node src/scripts/seedHmoIndebtednessDemo.js",
    "db:sync:store": "node -e \"require('dotenv').config(); require('./src/models/active').syncActiveSchema({alter:true}).then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)})\"",
    "db:sync-enrollee-register": "node src/scripts/legacy/addMonthlyEnrolleeRegister.js",
    "db:sync-etmc-action-point": "node src/scripts/legacy/addEtmcTmcActionPoint.js",
    "db:sync-beneficiary-management": "node src/scripts/legacy/addBeneficiaryManagement.js",
    "db:migrate-soc-zones-privileges": "node src/scripts/legacy/migrateSocZonesPrivileges.js",
    "db:migrate-access": "node src/scripts/legacy/migrateProductionAccess.js",
    "db:seed-weekly-compliance": "node src/scripts/seedWeeklyCompliance.js",
    "db:redesign:sync": "node src/scripts/redesign/syncRedesignSchema.js",
    "db:redesign:seed": "node src/scripts/redesign/seedRedesignCore.js",
    "db:redesign:backfill-enrolment": "node src/scripts/redesign/backfillEnrolment.js",
    "db:redesign:setup": "npm run db:redesign:sync && npm run db:redesign:seed && npm run db:redesign:backfill-enrolment",
    "db:redesign:lean": "node src/scripts/redesign/createLeanDatabase.js --db=nhia_urms_v2 --drop-first",
    "db:redesign:sync-provider": "node src/scripts/redesign/syncDedicatedProviderTables.js",
    "db:redesign:migrate-provider": "node src/scripts/redesign/migrateAccreditationToDedicated.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.7",
    "sequelize": "^6.37.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
