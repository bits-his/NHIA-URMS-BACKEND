PORT=3001
NODE_ENV=production

# MySQL — use your HOSTED database host, NOT localhost (unless MySQL is on the same VPS)
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_NAME=nhia_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Required for PlanetScale, Railway, Aiven, many cloud MySQL hosts
# DB_SSL=true

# CORS — your live frontend URL (exact origin, no trailing slash)
CLIENT_URL=https://your-frontend.example.com

JWT_SECRET=change-this-to-a-long-random-string
